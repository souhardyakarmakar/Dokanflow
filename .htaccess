Options -Indexes

<IfModule mod_authz_core.c>
    <FilesMatch "^(\.env(\..*)?|composer\.(json|lock)|phpunit\.xml|README\.md|Dont_read\.me)$">
        Require all denied
    </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(app|bin|config|database|storage|tests|vendor)(/|$) - [F,END]
</IfModule>
